# Backend Server Configuration
PORT=5001
NODE_ENV=development

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_12345

# LLM API (Gemini / OpenAI compatible)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Policy Engine Safeguards (Paise integer values)
# 10,000 INR = 1,000,000 paise
MAX_AUTONOMOUS_RECOVERY_AMOUNT=1000000
MAX_RETRY_ATTEMPTS=3
MAX_CUSTOMER_RECOVERY_CONTACTS=1
MIN_AI_CONFIDENCE=0.70
ACTION_EXPIRY_MINUTES=15
