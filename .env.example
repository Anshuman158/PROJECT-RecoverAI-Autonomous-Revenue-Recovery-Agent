# ==============================================================================
# RecoverAI — Autonomous Revenue Recovery Agent
# Environment Configuration & Documentation
# ==============================================================================
# Copy this file to '.env' and populate with your credentials.
# Note: In production, never commit the actual '.env' file containing secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration
# ------------------------------------------------------------------------------
# PORT: Port where the Node/Express backend server listens (default: 5001)
PORT=5001

# NODE_ENV: Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# FRONTEND_URL: URL where the React/Vite dashboard runs (used for CORS and redirect links)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Razorpay API & Webhook Credentials
# ------------------------------------------------------------------------------
# Get your Test/Live API keys from: https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID: Razorpay Key ID (starts with rzp_test_ or rzp_live_)
RAZORPAY_KEY_ID=rzp_test_placeholder_key

# RAZORPAY_KEY_SECRET: Razorpay Key Secret for authenticated API requests
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# RAZORPAY_WEBHOOK_SECRET: Secret used to compute HMAC-SHA256 signatures on incoming webhooks
# Configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_12345

# ------------------------------------------------------------------------------
# 3. AI / LLM Configuration
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key for dynamic strategy synthesis & copy generation
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=

# LLM_MODEL: Model identifier for reasoning tasks (e.g. gemini-2.5-flash or gemini-1.5-pro)
LLM_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Fintech Policy Engine Safeguards & Guardrails
# ------------------------------------------------------------------------------
# All monetary values are strictly represented in INTEGER PAISE (1 INR = 100 paise)
# to prevent floating-point rounding errors.

# MAX_AUTONOMOUS_RECOVERY_AMOUNT: Maximum transaction amount the AI agent can autonomously
# recover without human merchant approval. 
# Example: 10,000 INR = 1,000,000 paise
MAX_AUTONOMOUS_RECOVERY_AMOUNT=1000000

# MAX_RETRY_ATTEMPTS: Hard ceiling on retry attempts per case before permanently escalating
MAX_RETRY_ATTEMPTS=3

# MAX_CUSTOMER_RECOVERY_CONTACTS: Maximum autonomous customer messages per 24 hours (anti-spam)
MAX_CUSTOMER_RECOVERY_CONTACTS=1

# MIN_AI_CONFIDENCE: Minimum confidence threshold (0.00 - 1.00) required to auto-execute.
# Decisions below this threshold automatically escalate to Human-in-the-Loop (HITL) review.
MIN_AI_CONFIDENCE=0.70

# ACTION_EXPIRY_MINUTES: Lifetime of generated recovery checkout links in minutes
ACTION_EXPIRY_MINUTES=15
